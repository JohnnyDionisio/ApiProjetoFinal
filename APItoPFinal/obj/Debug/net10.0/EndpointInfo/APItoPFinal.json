  "components": {
    "schemas": {
      "Compra": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "cpf": {
            "type": "string"
          },
          "dataCompra": {
            "type": "string",
            "format": "date-time"
          },
          "instrumentoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Instrumento": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identificação": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "preco": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "tipo": {
            "type": "string"
          },
          "marca": {
            "type": "string"
          },
          "descricao": {
            "type": "string"
          },
          "disponibilidade": {
            "type": "boolean"
          },
          "compras": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Compra"
            }
          }
        }
      },
      "WeatherForecast": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date"
          },
          "temperatureC": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "temperatureF": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      }
    }
