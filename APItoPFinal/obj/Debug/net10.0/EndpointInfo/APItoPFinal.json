    "/api/Instrumentos": {
      "get": {
        "tags": [
          "Instrumentos"
        ],
        "parameters": [
          {
            "name": "Busca",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "CategoriaId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "MarcaId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "PrecoMin",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          },
          {
            "name": "PrecoMax",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
              "type": [
                "number",
                "string"
              ],
              "format": "double"
            }
          },
          {
            "name": "Disponivel",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "OrdenarPor",
            "in": "query",
            "schema": {
              "pattern": "(?i)^(nome|pre[cç]o)$",
              "type": "string"
            }
          },
          {
            "name": "Decrescente",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "Pagina",
            "in": "query",
            "schema": {
              "maximum": 100000,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "Tamanho",
            "in": "query",
            "schema": {
              "maximum": 100,
              "minimum": 1,
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/PaginadoDTOOfInstrumentoDTO"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginadoDTOOfInstrumentoDTO"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginadoDTOOfInstrumentoDTO"
                }
              }
            }
          }
        },
        "security": [
          {
            "Bearer": [ ]
          }
        ]
      },
