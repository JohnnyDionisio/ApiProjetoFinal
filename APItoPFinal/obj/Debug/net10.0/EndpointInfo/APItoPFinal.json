  "components": {
    "schemas": {
      "Categoria": {
        "required": [
          "nome"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "maxLength": 15,
            "minLength": 0,
            "type": "string"
          },
          "instrumentos": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Instrumento"
            }
          }
        }
      },
      "CategoriaDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "type": "string"
          },
          "instrumentos": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/InstrumentoResumoDTO"
            }
          }
        }
      },
      "Compra": {
        "required": [
          "nome",
          "cpf"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "nome": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "cpf": {
            "maxLength": 11,
            "minLength": 0,
            "type": "string"
          },
          "dataCompra": {
            "type": "string",
            "format": "date-time"
          },
          "instrumentoId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Instrumento": {
        "required": [
          "identificação",
          "nome",
          "preco",
          "descricao"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identificação": {
            "type": "string"
          },
          "nome": {
            "maxLength": 50,
            "minLength": 0,
            "type": "string"
          },
          "preco": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "descricao": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "disponibilidade": {
            "type": "boolean"
          },
          "idCategoria": {
            "type": "string",
            "format": "uuid"
          },
          "categoria": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Categoria"
              }
            ]
          },
          "idMarca": {
            "type": "string",
            "format": "uuid"
          },
          "marca": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Marca"
              }
            ]
          },
          "compras": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/Compra"
            }
          }
        }
      },
      "InstrumentoDTO": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "identificação": {
            "type": "string"
